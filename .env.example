# Copie para .env e preencha os valores reais (.env não é versionado).

# --- WAHA (WhatsApp) ---
WAHA_API_KEY=troque-por-uma-chave-aleatoria-forte
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-por-uma-senha-forte

# --- Backend ---
# Chave da API Gemini (console.cloud.google.com / aistudio.google.com).
GOOGLE_API_KEY=

# Protege /ingest/health-connect e /api/classificar-mensagem com o header
# X-Api-Key. Opcional em rede local, OBRIGATÓRIO se o backend ficar
# exposto na internet (VPS) — sem isso, qualquer pessoa pode injetar
# leituras de sensor ou classificar mensagens arbitrárias.
ZELA_INGESTAO_TOKEN=

# --- Painel Streamlit (família) ---
STREAMLIT_SENHA=troque-por-uma-senha-forte

# --- Portas no host (opcional) ---
# Mude só se a porta padrão já estiver em uso por outro serviço na VPS
# (comum em VPS compartilhada com outros projetos).
# BACKEND_PORT=8000
# STREAMLIT_PORT=8501
# WAHA_PORT=3000
