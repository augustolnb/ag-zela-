# Copie para .env e preencha os valores reais (.env não é versionado).

# --- WAHA (WhatsApp) ---
WAHA_API_KEY=troque-por-uma-chave-aleatoria-forte
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-por-uma-senha-forte

# --- Backend ---
# Chave da API Gemini. Sempre necessária: os embeddings (RAG e
# classificação) usam o Gemini mesmo com ZELA_LLM_PROVEDOR=deepseek.
GOOGLE_API_KEY=

# LLM da conversa: "gemini" (padrão) ou "deepseek" (exige DEEPSEEK_API_KEY).
ZELA_LLM_PROVEDOR=gemini
DEEPSEEK_API_KEY=

# Token exigido no header X-Api-Key por /ingest/*, /api/classificar-mensagem
# e /webhook/whatsapp. Opcional em rede local, OBRIGATÓRIO em servidor
# exposto na internet.
ZELA_INGESTAO_TOKEN=

# --- Google Agenda e Gmail na pulseira (opcional) ---
# Credencial OAuth "Desktop app" e refresh_token gerado por
# scripts/obter_refresh_token_google.py (ver README).
ZELA_GOOGLE_CALENDAR_CLIENT_ID=
ZELA_GOOGLE_CALENDAR_CLIENT_SECRET=
ZELA_GOOGLE_CALENDAR_REFRESH_TOKEN=
ZELA_GOOGLE_CALENDAR_CALENDAR_ID=
# E-mail da conta do idoso; vazio desliga o aviso pelo Gmail.
ZELA_GMAIL_PULSEIRA_EMAIL=
# "insert" (padrão) ou "send".
ZELA_GMAIL_MODO=insert

# --- Portas no host (opcional) ---
# Mude só se a porta padrão já estiver em uso no servidor.
# BACKEND_PORT=8000
# STREAMLIT_PORT=8501
# WAHA_PORT=3000
